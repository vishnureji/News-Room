  "dynamicRoutes": [
    {
      "page": "/admin/articles/[id]/edit",
      "regex": "^/admin/articles/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/articles/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/article/[slug]",
      "regex": "^/article/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/article/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
